{
  "name": "site-mayara-bacellar",
  "version": "1.0.0",
  "description": "Site de pré-avaliação de harmonização facial de Mayara Bacellar",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && node scripts/postbuild.mjs out",
    "reviews": "node scripts/fetch-reviews.mjs",
    "preview": "node scripts/serve-static.mjs out 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "faces": "node scripts/generate-faces.mjs",
    "images": "node scripts/generate-images.mjs",
    "prototype": "node scripts/prototype/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.33.5",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
