# Copy to .env (kept out of git) and fill in.
# Google Cloud key (Places API (New)) used by `npm run reviews` to save the reviews at build time.
# It never goes into the site; keep it secret.
GOOGLE_MAPS_KEY=

# Google Analytics 4 measurement ID (G-...). Public, not secret, but normally left empty here so local visits are not
# counted; the real one comes from the GA_MEASUREMENT_ID repository variable at deploy.
VITE_GA_MEASUREMENT_ID=
